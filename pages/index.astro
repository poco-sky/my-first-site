---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePanel from '../components/HomePanel.astro';
import { homePanels } from '../data/home';
---
<BaseLayout pageTitle="マイサイト" home>
 <h1 class="sr-only">マイサイト — 好きなものを、好きなように。</h1>
 <div class="home-gallery"><HomePanel panel={homePanels[0]} first /><div class="paired-panels"><HomePanel panel={homePanels[1]} /><HomePanel panel={homePanels[2]} /></div><HomePanel panel={homePanels[3]} /></div>
</BaseLayout>
