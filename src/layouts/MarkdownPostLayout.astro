---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter, previousPost = null, nextPost = null } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <nav slot="before-title" class="article-navigation" aria-label="前後の記事">
    {
      previousPost && (
        <a class="previous-post" href={`/posts/${previousPost.id}/`} rel="prev">
          ← 前の記事を読む
        </a>
      )
    }

    {
      nextPost && (
        <a class="next-post" href={`/posts/${nextPost.id}/`} rel="next">
          次の記事を読む →
        </a>
      )
    }
  </nav>
  <p><em>{frontmatter.description}</em></p>
  <p>{frontmatter.pubDate.toLocaleDateString()}</p>
  <p>著者: {frontmatter.author}</p>
  {
    frontmatter.image && (
      <img
        class="post-cover"
        src={frontmatter.image.url}
        alt={frontmatter.image.alt}
      />
    )
  }

  <div class="tags">
    {
      frontmatter.tags.map((tag: string) => (
        <p class="tag">
          <a href={`/tags/${tag}`}>{tag}</a>
        </p>
      ))
    }
  </div>

  <article class="article-body">
    <slot />
  </article>

  <nav
    class="article-navigation article-navigation-bottom"
    aria-label="記事末尾の前後の記事"
  >
    {
      previousPost && (
        <a class="previous-post" href={`/posts/${previousPost.id}/`} rel="prev">
          ← 前の記事を読む
        </a>
      )
    }

    {
      nextPost && (
        <a class="next-post" href={`/posts/${nextPost.id}/`} rel="next">
          次の記事を読む →
        </a>
      )
    }
  </nav>

  <a class="text-link" href="/blog/">← ブログ一覧へ</a>
</BaseLayout>

<style>
  /* 記事内のタグのスタイル */
  a {
    color: var(--link);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px var(--border);
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: var(--tag-bg);
  }
  /* 記事内の前後の記事遷移ボタン */
  .article-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .article-navigation:empty {
    display: none;
  }

  .article-navigation a {
    display: inline-block;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text);
    font-size: 12px;
    text-decoration: none;
  }

  .article-navigation a:hover {
    background: var(--surface-hover);
  }

  .next-post {
    margin-left: auto;
  }

  @media (max-width: 700px) {
    .article-navigation {
      gap: 8px;
    }

    .article-navigation a {
      padding: 9px 10px;
      font-size: 11px;
    }
  }
  .article-navigation-bottom {
    margin-top: 40px;
    margin-bottom: 0;
  }
</style>
