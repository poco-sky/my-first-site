---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter, previousPost = null, nextPost = null } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <div slot="before-title" class="article-back">
    <a class="text-link" href="/blog/">← ブログ一覧へ</a>
  </div>
  <p><em>{frontmatter.description}</em></p>
  <p>
    {
      frontmatter.pubDate.toLocaleDateString("ja-JP", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        timeZone: "Asia/Tokyo",
      })
    }
  </p>
  <p>著者: {frontmatter.author}</p>
  {
    frontmatter.image && (
      <img
        class="post-cover"
        src={frontmatter.image.url}
        alt={frontmatter.image.alt}
      />
    )
  }

  <div class="tags">
    {
      frontmatter.tags.map((tag: string) => (
        <p class="tag">
          <a href={`/tags/${tag}`}>{tag}</a>
        </p>
      ))
    }
  </div>

  <article class="article-body">
    <slot />
  </article>

  <nav
    class="article-navigation article-navigation-bottom"
    aria-label="記事末尾の前後の記事"
  >
    {
      previousPost && (
        <a class="previous-post" href={`/posts/${previousPost.id}/`} rel="prev">
          ← 前の記事を読む
        </a>
      )
    }

    {
      nextPost && (
        <a class="next-post" href={`/posts/${nextPost.id}/`} rel="next">
          次の記事を読む →
        </a>
      )
    }
  </nav>
  <article-scroll-top>
    <button type="button" aria-label="記事の一番上へ戻る" hidden>
      ページTOPへ
    </button>
  </article-scroll-top>
</BaseLayout>

<style>
  /* 記事内のタグのスタイル */
  a {
    color: var(--link);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px var(--border);
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: var(--tag-bg);
  }
  /* 記事内の前後の記事遷移ボタン */
  .article-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .article-navigation:empty {
    display: none;
  }

  .article-navigation a {
    display: inline-block;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text);
    font-size: 12px;
    text-decoration: none;
  }

  .article-navigation a:hover {
    background: var(--surface-hover);
  }

  .next-post {
    margin-left: auto;
  }

  @media (max-width: 700px) {
    .article-navigation {
      gap: 8px;
    }

    .article-navigation a {
      padding: 9px 10px;
      font-size: 11px;
    }
  }
  .article-navigation-bottom {
    margin-top: 40px;
    margin-bottom: 0;
  }
  .article-back {
    margin-bottom: 28px;
  }
  article-scroll-top button {
    position: fixed;
    left: calc((100% - var(--music-panel-width, 0px)) / 2);
    bottom: calc(40px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 20;
    display: grid;
    place-items: center;
    background: var(--page-bg);
    color: var(--text);
    width: auto;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 13px;
    white-space: nowrap;
    line-height: 2;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(16, 16, 16, 0.12);
  }

  article-scroll-top button[hidden] {
    display: none;
  }

  article-scroll-top button:hover {
    background: var(--surface-hover);
  }

  :global(html[data-music-active="true"]) article-scroll-top button {
    bottom: calc(
      var(--music-bar-height, 76px) + 24px + env(safe-area-inset-bottom)
    );
  }
</style>
<script>
  class ArticleScrollTop extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();

      const button = this.querySelector("button");
      if (!button) return;

      const { signal } = this.controller;

      const update = () => {
        button.hidden = window.scrollY < 300;
      };

      window.addEventListener("scroll", update, {
        passive: true,
        signal,
      });

      button.addEventListener(
        "click",
        () => {
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "instant"
              : "smooth",
          });
        },
        { signal },
      );

      update();
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get("article-scroll-top")) {
    customElements.define("article-scroll-top", ArticleScrollTop);
  }
</script>
