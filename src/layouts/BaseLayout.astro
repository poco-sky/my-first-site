---
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.astro";
import "../styles/music.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
const {
  pageTitle = "マイサイト",
  description = "好きなものを、好きなように。ファッション、音楽、そして日々の記録。",
  home = false,
  music = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja" transition:animate="none">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><meta
      name="theme-color"
      content="#ffffff"
    /><link rel="icon" type="image/png" href="/icon.png" /><title>
      {pageTitle === "IN THE SKY" ? pageTitle : `${pageTitle} | IN THE SKY`}
    </title>
    <ClientRouter />
    <script is:inline>
      // 描画前に保存したテーマを復元して、ページ移動時の白いちらつきを防ぐ。
      try {
        const dark = localStorage.getItem("my-site-theme") === "dark";
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document
          .querySelector('meta[name="theme-color"]')
          .setAttribute("content", dark ? "#101112" : "#ffffff");
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body id="top" class:list={{ "home-page": home }}
    ><div id="site-shell">
      <a class="skip-link" href="#main">本文へ移動</a><Header /><main
        id="main"
        tabindex="-1"
        class:list={{
          "page-content": !home,
          "music-page": music,
          "post-page": Astro.url.pathname.startsWith("/posts/"),
        }}
      >
        <slot name="before-title" />
        {!home && <h1>{pageTitle}</h1>}<slot />
      </main><Footer />
    </div><MusicPlayer /></body>
</html>
