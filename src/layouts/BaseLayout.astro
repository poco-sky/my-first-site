---
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.astro";
import "../styles/music.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import SocialLinks from "../components/SocialLinks.astro";

const isPostPage = Astro.url.pathname.startsWith("/posts/");
const {
  pageTitle = "IN THE SKY",
  description = "IN THE SKYはSoraの個人サイトです．オリジナルの洋楽やInstrumental，オリジナルブランド「POCO DI TINI」の服，日々のブログを公開しています．",
  home = false,
  music = false,
  fashion = false,
  fashionDetail = false,
} = Astro.props;

const shareTitle = "IN THE SKY";
const shareDescription = "Sora's fashion of POCO DI TINI, music and blog.";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site!);
const shareImageUrl = new URL("/images/ogp.jpg", Astro.site!);
---

<!doctype html>
<html lang="ja" transition:animate="none">
  <head
    ><meta
      name="google-site-verification"
      content="dhkUfbnkATExl4E3Fk9wJQfoTx4u_UtTyMGk71Q9mSo"
    /><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><meta
      name="theme-color"
      content="#ffffff"
    /><link rel="icon" type="image/png" href="/icon.png" /><title>
      {pageTitle === "IN THE SKY" ? pageTitle : `${pageTitle} | IN THE SKY`}
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IN THE SKY" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={shareImageUrl.href} />
    <meta property="og:image:alt" content="IN THE SKY — Soraの個人サイト" />
    <meta property="og:locale" content="ja_JP" />
    <ClientRouter />
    {
      Astro.url.pathname === "/" && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "IN THE SKY",
            alternateName: "IN THE SKY | Sora",
            url: "https://sora.sky-me.workers.dev/",
          })}
        />
      )
    }
    <script is:inline>
      // 描画前に保存したテーマを復元して、ページ移動時の白いちらつきを防ぐ。
      try {
        const dark = localStorage.getItem("my-site-theme") === "dark";
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document
          .querySelector('meta[name="theme-color"]')
          .setAttribute("content", dark ? "#101112" : "#ffffff");
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body
    id="top"
    class:list={{
      "home-page": home || fashion,
      "fashion-page": fashion,
      "fashion-detail-page": fashionDetail,
    }}
    ><div id="site-shell">
      <a class="skip-link" href="#main">本文へ移動</a><Header /><main
        id="main"
        tabindex="-1"
        class:list={{
          "page-content": !home && !fashion && !fashionDetail,
          "music-page": music,
          "post-page": Astro.url.pathname.startsWith("/posts/"),
        }}
      >
        <slot name="before-title" />
        {
          !home && !fashion && !fashionDetail && (
            <h1
              class:list={{
                "custom-page-title":
                  ["/about", "/music", "/blog"].includes(
                    Astro.url.pathname.replace(/\/+$/, ""),
                  ) || Astro.url.pathname.startsWith("/tags/"),
              }}
            >
              {pageTitle}
            </h1>
          )
        }
        <slot />
        <SocialLinks />

        {
          !isPostPage && !home && (
            <a class="text-link" href="/">
              ← ホームに戻る
            </a>
          )
        }
      </main><Footer />
    </div><MusicPlayer /></body>
</html>
