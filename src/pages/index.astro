---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePanel from "../components/HomePanel.astro";
import { homePanels } from "../data/home";
---

<BaseLayout pageTitle="Home" home>
    <h1 class="sr-only">IN THE SKYはSoraの個人サイトです．オリジナルの洋楽やInstrumental，オリジナルブランド「POCO DI TINI」の服，日々のブログを公開しています．</h1>
    <div class="home-gallery">
        <HomePanel panel={homePanels[0]} first /><div class="paired-panels">
            <HomePanel panel={homePanels[1]} /><HomePanel
                panel={homePanels[2]}
            />
        </div><HomePanel panel={homePanels[3]} />
    </div>
</BaseLayout>
