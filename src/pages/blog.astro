---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
// 冒頭の画像 → 本文の最初の画像の順に取得
function getThumbnail(post: (typeof posts)[number]) {
    return (
        post.data.image?.url ||
        post.body?.match(
            /!\[[^\]]*\]\(\s*<?([^\s)>]+)>?(?:\s+"[^"]*")?\s*\)/,
        )?.[1]
    );
}
---

<BaseLayout pageTitle="Blog"
    ><nav class="tag-list blog-tags" aria-label="記事のタグ">
        <a href="/blog/" class="is-selected" aria-current="page"> All </a>
        {
            tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))
        }
    </nav><ul class="post-list">
        {
            posts.map((post) => (
                <li>
                    <a
                        href={`/posts/${post.id}/`}
                        class:list={{
                            "post-row": true,
                            "has-thumbnail": Boolean(getThumbnail(post)),
                        }}
                    >
                        <>
                            <div class="post-meta">
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                >
                                    {post.data.pubDate
                                        .toISOString()
                                        .slice(0, 10)
                                        .replaceAll("-", ".")}
                                </time>

                                <span class="post-meta-tags">
                                    {post.data.tags.map((tag) => (
                                        <span class="post-meta-tag">
                                            #{tag}
                                        </span>
                                    ))}
                                </span>
                            </div>
                            <h2>{post.data.title}</h2>
                            <p>{post.data.description}</p>
                            {getThumbnail(post) && (
                                <img
                                    class="post-thumbnail"
                                    src={getThumbnail(post)}
                                    alt=""
                                    width="64"
                                    height="64"
                                    loading="lazy"
                                />
                            )}
                        </>
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
<style>
    .post-meta {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 6px 14px;
    }

    .post-meta-tags {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 4px 10px;
    }

    .post-meta-tag {
        font-size: 12px;
        color: var(--link);
    }
    @media (max-width: 700px) {
        .post-list .post-row h2 {
            font-size: 18px;
        }
    }
</style>
