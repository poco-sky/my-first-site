---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
// 冒頭の画像 → 本文の最初の画像の順に取得
function getThumbnail(post: (typeof posts)[number]) {
    return (
        post.data.image?.url ||
        post.body?.match(
            /!\[[^\]]*\]\(\s*<?([^\s)>]+)>?(?:\s+"[^"]*")?\s*\)/,
        )?.[1]
    );
}
---

<BaseLayout pageTitle="Blog"
    ><p class="blog-intro">
        サイト完成までの進捗報告や何気ない日々の思い出を、少しずつ。
    </p><nav class="tag-list" aria-label="記事のタグ">
        {
            tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))
        }
    </nav><ul class="post-list">
        {
            posts.map((post) => (
                <li>
                    <a
                        href={`/posts/${post.id}/`}
                        class:list={{
                            "post-row": true,
                            "has-thumbnail": Boolean(getThumbnail(post)),
                        }}
                    >
                        <>
                            <time datetime={post.data.pubDate.toISOString()}>
                                {post.data.pubDate
                                    .toISOString()
                                    .slice(0, 10)
                                    .replaceAll("-", ".")}
                            </time>
                            <h2>{post.data.title}</h2>
                            <p>{post.data.description}</p>
                            {getThumbnail(post) && (
                                <img
                                    class="post-thumbnail"
                                    src={getThumbnail(post)}
                                    alt=""
                                    width="64"
                                    height="64"
                                    loading="lazy"
                                />
                            )}
                        </>
                    </a>
                </li>
            ))
        }
    </ul>
    <a class="text-link" href="/">← ホームに戻る</a>
</BaseLayout>
