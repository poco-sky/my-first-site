---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    pageTitle="ページが見つかりません"
    description="指定されたページが見つかりませんでした。"
    home
>
    <section class="not-found-hero" aria-label="ページが見つかりません">
        <h1 class="sr-only">404：ページが見つかりません</h1>

        <picture>
            <source
                media="(max-width: 700px)"
                srcset="/images/404-mobile.png"
            />
            <img
                src="/images/404-pc.png"
                alt="指定されたページが見つかりませんでした。"
                fetchpriority="high"
            />
        </picture>
    </section>
</BaseLayout>

<style>
    .not-found-hero {
        position: relative;
        width: 100%;
        height: 100vh;
        height: 100svh;
        overflow: hidden;
    }

    .not-found-hero picture {
        display: block;
        width: 100%;
        height: 100%;
    }

    .not-found-hero img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }
    /* 404ページ専用のヘッダー文字色 */
    :global(html:not([data-theme="dark"]) body:has(.not-found-hero)) {
        --not-found-header-color: #000;
    }

    :global(html[data-theme="dark"] body:has(.not-found-hero)) {
        --not-found-header-color: #fff;
    }

    /* サイト名・ナビゲーション・各ボタン */
    :global(body:has(.not-found-hero) .site-header .wordmark),
    :global(body:has(.not-found-hero) .site-header #main-menu a),
    :global(body:has(.not-found-hero) .site-header .theme-toggle),
    :global(body:has(.not-found-hero) .site-header .notice-toggle),
    :global(body:has(.not-found-hero) .site-header .menu-toggle) {
        color: var(--not-found-header-color);
        text-shadow: none;
    }

    /* お知らせを開いている間は背景と文字色を反転 */
    :global(
        body:has(.not-found-hero)
            .site-header
            .notice-toggle[aria-expanded="true"]
    ) {
        background: var(--not-found-header-color);
        color: var(--page-bg);
    }
</style>
