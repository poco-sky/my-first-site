---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    pageTitle="404 Not Found"
    description="指定されたページが見つかりませんでした。"
    home
>
    <section class="not-found-hero" aria-label="ページが見つかりません">
        <h1 class="sr-only">404：ページが見つかりません</h1>

        <picture>
            <source
                media="(max-width: 700px)"
                srcset="/images/404-mobile.png"
            />
            <img
                src="/images/404-pc.png"
                alt="指定されたページが見つかりませんでした。"
                fetchpriority="high"
            />
        </picture>
        <span class="not-found-credit">© 2026 Sora</span>
    </section>
</BaseLayout>

<style>
    .not-found-hero {
        position: relative;
        width: 100%;
        height: 100vh;
        height: 100svh;
        overflow: hidden;
    }

    .not-found-hero picture {
        display: block;
        width: 100%;
        height: 100%;
    }

    .not-found-hero img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }
    /* 白テーマ */
    :global(html:not([data-theme="dark"]) body:has(.not-found-hero)) {
        --not-found-header-color: #000;

        /* 通常のボタンにカーソルを当てた時 */
        --404-button-hover-bg: #e6e6e6;

        /* 開いているお知らせボタンにカーソルを当てた時 */
        --404-notice-open-hover-bg: #333;
    }

    /* 黒テーマ */
    :global(html[data-theme="dark"] body:has(.not-found-hero)) {
        --not-found-header-color: #fff;

        /* 通常のボタンにカーソルを当てた時 */
        --404-button-hover-bg: #3b3b3b;

        /* 開いているお知らせボタンにカーソルを当てた時 */
        --404-notice-open-hover-bg: #ddd;
    }

    /* サイト名・ナビゲーション・各ボタン */
    :global(body:has(.not-found-hero) .site-header .wordmark),
    :global(body:has(.not-found-hero) .site-header #main-menu a),
    :global(body:has(.not-found-hero) .site-header .theme-toggle),
    :global(body:has(.not-found-hero) .site-header .notice-toggle),
    :global(body:has(.not-found-hero) .site-header .menu-toggle) {
        color: var(--not-found-header-color);
        text-shadow: none;
    }

    /* お知らせを開いている間は背景と文字色を反転 */
    :global(
        body:has(.not-found-hero)
            .site-header
            .notice-toggle[aria-expanded="true"]
    ) {
        background: var(--not-found-header-color);
        color: var(--page-bg);
    }
    /* ヒーロー画像の左下に重ねるコピーライト */
    .not-found-credit {
        position: absolute;
        left: 32px;
        bottom: 30px;
        z-index: 1;

        color: var(--not-found-header-color, #000);
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.06em;
        line-height: 1.5;
        text-shadow: none;
        pointer-events: none;
    }

    @media (max-width: 700px) {
        .not-found-credit {
            left: 16px;
            bottom: 16px;
            font-size: 10px;
        }
    }

    /* ライトモードではテーマ切り替えボタンの枠も黒にする */
    /* 白テーマの枠線 */
    :global(
        html:not([data-theme="dark"])
            body:has(.not-found-hero)
            .site-header
            .theme-toggle
    ) {
        border: 1px solid #d9d9d9;
    }

    /* 黒テーマの枠線 */
    :global(
        html[data-theme="dark"]
            body:has(.not-found-hero)
            .site-header
            .theme-toggle
    ) {
        border: 1px solid #454444;
    }
    @media (max-width: 700px) {
        /* ライトモード */
        :global(
            body:has(.not-found-hero)
                .site-header:has(.menu-toggle[aria-expanded="true"])
                #main-menu
        ) {
            background: #fff;
            opacity: 1;
            backdrop-filter: none;
        }

        /* ダークモード */
        :global(
            html[data-theme="dark"]
                body:has(.not-found-hero)
                .site-header:has(.menu-toggle[aria-expanded="true"])
                #main-menu
        ) {
            background: #101112;
        }
    }

    @media (hover: hover) {
        /* 白テーマ：テーマ切り替え・閉じているお知らせ */
        :global(
            html[data-theme="light"]
                body:has(.not-found-hero)
                .site-header
                .theme-toggle:hover
        ),
        :global(
            html[data-theme="light"]
                body:has(.not-found-hero)
                .site-header
                .notice-toggle:not([aria-expanded="true"]):hover
        ) {
            background: #e6e6e6 !important;
        }

        /* 黒テーマ：テーマ切り替え・閉じているお知らせ */
        :global(
            html[data-theme="dark"]
                body:has(.not-found-hero)
                .site-header
                .theme-toggle:hover
        ),
        :global(
            html[data-theme="dark"]
                body:has(.not-found-hero)
                .site-header
                .notice-toggle:not([aria-expanded="true"]):hover
        ) {
            background: #3b3b3b !important;
        }

        /* 白テーマ：開いているお知らせ */
        :global(
            html[data-theme="light"]
                body:has(.not-found-hero)
                .site-header
                .notice-toggle[aria-expanded="true"]:hover
        ) {
            background: #333 !important;
        }

        /* 黒テーマ：開いているお知らせ */
        :global(
            html[data-theme="dark"]
                body:has(.not-found-hero)
                .site-header
                .notice-toggle[aria-expanded="true"]:hover
        ) {
            background: #ddd !important;
        }
    }
    /* 404ページのお知らせボタンを丸い枠線で囲む */
    :global(body:has(.not-found-hero) .site-header .notice-toggle) {
        --notice-ring-color: #d9d9d9; /* 枠線の色 */
        border: 1px solid var(--notice-ring-color);
        border-radius: 50%;
    }

    /* 黒テーマでは白い枠線 */
    :global(
        html[data-theme="dark"]
            body:has(.not-found-hero)
            .site-header
            .notice-toggle
    ) {
        --notice-ring-color: #454444;
    }
</style>
