---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      posts: allPosts.filter((post) => post.data.tags.includes(tag)),
      tags: uniqueTags,
    },
  }));
}

const { tag } = Astro.params;
const { posts, tags } = Astro.props;

function getThumbnail(post: (typeof posts)[number]) {
  return (
    post.data.image?.url ||
    post.body?.match(/!\[[^\]]*\]\(\s*<?([^\s)>]+)>?(?:\s+"[^"]*")?\s*\)/)?.[1]
  );
}
---

<BaseLayout pageTitle={tag}>
  <p>{tag}のタグが付いた記事</p>

  <nav class="tag-list" aria-label="記事のタグ">
    {
      tags.map((item) => (
        <a
          href={item === tag ? "/blog/" : `/tags/${encodeURIComponent(item)}/`}
          class:list={{ "is-selected": item === tag }}
          aria-current={item === tag ? "true" : undefined}
          aria-label={
            item === tag ? `${item}の絞り込みを解除してブログ一覧へ` : undefined
          }
        >
          {item}
        </a>
      ))
    }
  </nav>

  <ul class="post-list">
    <ul class="post-list">
      {
        posts.map((post) => {
          const thumbnail = getThumbnail(post);

          return (
            <li>
              <a
                href={`/posts/${post.id}/`}
                class:list={{
                  "post-row": true,
                  "has-thumbnail": Boolean(thumbnail),
                }}
              >
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate
                    .toISOString()
                    .slice(0, 10)
                    .replaceAll("-", ".")}
                </time>

                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>

                {thumbnail && (
                  <img
                    class="post-thumbnail"
                    src={thumbnail}
                    alt=""
                    loading="lazy"
                  />
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </ul>
  <a class="text-link" href="/">← ホームに戻る</a>
</BaseLayout>
