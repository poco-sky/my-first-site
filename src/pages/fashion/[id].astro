---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fashionBrand } from "../../data/fashion";
import "../../styles/fashion.css";
export async function getStaticPaths() {
    return (await getCollection("fashion")).map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}
interface Props {
    item: CollectionEntry<"fashion">;
}
const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout
    pageTitle={item.data.title}
    description={item.data.description}
    fashionDetail
>
    <article class="fashion-detail">
        <div class="fashion-detail-top">
            <a href="/fashion/">← COLLECTION</a><span>{fashionBrand.name}</span>
        </div>
        <div class="fashion-detail-columns">
            <div class="fashion-media">
                <div
                    class="fashion-thumbnails"
                    role="group"
                    aria-label="表示する写真"
                >
                    {
                        item.data.images.map((image, index) => (
                            <button
                                type="button"
                                data-fashion-photo={index}
                                aria-label={`写真${index + 1}を表示`}
                                aria-controls="fashion-detail-gallery"
                            >
                                <img src={image.src} alt="" loading="lazy" />
                            </button>
                        ))
                    }
                </div>

                <div class="fashion-mobile-frame">
                    <div
                        id="fashion-detail-gallery"
                        class="fashion-gallery"
                        tabindex="0"
                        role="region"
                        aria-label={`${item.data.title}の写真`}
                    >
                        {
                            item.data.images.map((image, index) => (
                                <figure>
                                    <img
                                        src={image.src}
                                        alt={image.alt}
                                        width="750"
                                        height="1000"
                                        loading={index < 3 ? "eager" : "lazy"}
                                    />
                                    <figcaption>
                                        {String(index + 1).padStart(2, "0")} /{" "}
                                        {String(
                                            item.data.images.length,
                                        ).padStart(2, "0")}
                                    </figcaption>
                                </figure>
                            ))
                        }
                    </div>

                    <button
                        type="button"
                        class="fashion-photo-arrow fashion-photo-prev"
                        aria-label="前の写真"
                        aria-controls="fashion-detail-gallery">←</button
                    >

                    <button
                        type="button"
                        class="fashion-photo-arrow fashion-photo-next"
                        aria-label="次の写真"
                        aria-controls="fashion-detail-gallery">→</button
                    >
                </div>

                <p class="fashion-gallery-hint">
                    SCROLL TO EXPLORE <span aria-hidden="true">→</span>
                </p>
            </div>

            <div
                class="fashion-detail-copy"
                tabindex="0"
                role="region"
                aria-label="服の説明"
            >
                <p class="fashion-kicker">{item.data.category}</p>
                <h1>{item.data.title}</h1>
                <p>{item.data.description}</p>
                <div class="fashion-description"><Content /></div>
                <a class="text-link" href="/fashion/#fashion-items"
                    >← アイテム一覧へ</a
                >
            </div>
        </div>
    </article>
</BaseLayout>
<script>
    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const button = event.target.closest<HTMLButtonElement>(
            "[data-fashion-photo]",
        );
        if (!button || !window.matchMedia("(min-width: 1101px)").matches)
            return;

        const media = button.closest(".fashion-media");
        const gallery = media?.querySelector<HTMLElement>(".fashion-gallery");
        const index = Number(button.dataset.fashionPhoto);
        const photo = gallery?.querySelectorAll<HTMLElement>("figure")[index];

        if (!gallery || !photo) return;

        const top =
            photo.getBoundingClientRect().top -
            gallery.getBoundingClientRect().top +
            gallery.scrollTop;

        gallery.scrollTo({
            top,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
                .matches
                ? "auto"
                : "smooth",
        });
    });
    let mobileGalleryCleanup: (() => void) | undefined;

    const setupMobileFashionGallery = () => {
        mobileGalleryCleanup?.();

        const frame = document.querySelector<HTMLElement>(
            ".fashion-detail-page .fashion-mobile-frame",
        );
        if (!frame) return;

        const gallery = frame.querySelector<HTMLElement>(".fashion-gallery");
        const photos = Array.from(
            frame.querySelectorAll<HTMLElement>(".fashion-gallery figure"),
        );
        const prev = frame.querySelector<HTMLButtonElement>(
            ".fashion-photo-prev",
        );
        const next = frame.querySelector<HTMLButtonElement>(
            ".fashion-photo-next",
        );

        if (!gallery || !photos.length || !prev || !next) return;

        const controller = new AbortController();
        const { signal } = controller;
        const mobile = window.matchMedia("(max-width: 1100px)");
        let current = 0;
        let slideAnimations: Animation[] = [];

        const clearSlide = () => {
            slideAnimations.forEach((animation) => animation.cancel());
            slideAnimations = [];

            photos.forEach((photo) => {
                photo.classList.remove("is-leaving");
            });
        };

        const show = (index: number) => {
            const nextIndex = Math.max(0, Math.min(index, photos.length - 1));
            const previousIndex = current;

            clearSlide();

            current = nextIndex;

            photos.forEach((photo, i) => {
                photo.classList.toggle("is-current", i === current);
            });

            prev.disabled = current === 0;
            next.disabled = current === photos.length - 1;

            if (!mobile.matches) return;

            gallery.scrollTop = 0;
            gallery.scrollLeft = 0;

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (previousIndex === current || reducedMotion) return;

            const outgoing = photos[previousIndex];
            const incoming = photos[current];
            const direction = current > previousIndex ? 1 : -1;

            outgoing.classList.add("is-leaving");

            const options: KeyframeAnimationOptions = {
                duration: 320,
                easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            };

            const outgoingAnimation = outgoing.animate(
                [
                    { transform: "translateX(0)" },
                    { transform: `translateX(${-direction * 100}%)` },
                ],
                options,
            );

            const incomingAnimation = incoming.animate(
                [
                    { transform: `translateX(${direction * 100}%)` },
                    { transform: "translateX(0)" },
                ],
                options,
            );

            slideAnimations = [outgoingAnimation, incomingAnimation];

            outgoingAnimation.onfinish = () => {
                outgoing.classList.remove("is-leaving");
            };
        };

        // ページを離れたときにアニメーションも解除
        signal.addEventListener("abort", clearSlide, { once: true });

        prev.addEventListener("click", () => show(current - 1), { signal });
        next.addEventListener("click", () => show(current + 1), { signal });

        let start: { x: number; y: number; id: number } | null = null;

        gallery.addEventListener(
            "pointerdown",
            (event) => {
                if (!mobile.matches || !event.isPrimary || event.button !== 0)
                    return;

                start = {
                    x: event.clientX,
                    y: event.clientY,
                    id: event.pointerId,
                };
                gallery.setPointerCapture(event.pointerId);
            },
            { signal },
        );

        gallery.addEventListener(
            "pointerup",
            (event) => {
                if (!start || start.id !== event.pointerId) return;

                const dx = event.clientX - start.x;
                const dy = event.clientY - start.y;
                start = null;

                if (!mobile.matches) return;

                if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) {
                    show(current + (dx < 0 ? 1 : -1));
                }
            },
            { signal },
        );

        gallery.addEventListener(
            "pointercancel",
            () => {
                start = null;
            },
            { signal },
        );

        gallery.addEventListener(
            "keydown",
            (event) => {
                if (!mobile.matches) return;

                if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
                    event.preventDefault();
                    show(current + (event.key === "ArrowRight" ? 1 : -1));
                }
            },
            { signal },
        );

        mobile.addEventListener(
            "change",
            () => {
                start = null;
                show(current);
            },
            { signal },
        );

        show(0);
        mobileGalleryCleanup = () => controller.abort();
    };

    document.addEventListener("astro:page-load", setupMobileFashionGallery);
    document.addEventListener("astro:before-swap", () =>
        mobileGalleryCleanup?.(),
    );

    setupMobileFashionGallery();
</script>
