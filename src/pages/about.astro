---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
    profile,
    qualifications,
    skills,
    favorites,
    socials,
} from "../data/profile";
const timeline = [...qualifications].sort((a, b) =>
    a.date.localeCompare(b.date),
);
---

<BaseLayout pageTitle="My Profile">
    <div class="sora-profile">
        <section class="profile-intro" aria-labelledby="sora-name">
            <figure class="portrait">
                <img
                    src={profile.image}
                    alt={profile.imageAlt}
                    width="800"
                    height="900"
                /><figcaption>A LITTLE ABOUT ME</figcaption>
            </figure>
            <div class="bio">
                <h2 id="sora-name">
                    {profile.name}<span>.</span>
                </h2>
                <dl class="personal-details">
                    <div>
                        <dt>BirthYear</dt>
                        <dd>{profile.birthYear}</dd>
                    </div>
                    <div>
                        <dt>Pronoun</dt>
                        <dd>{profile.pronoun}</dd>
                    </div>
                    <div>
                        <dt>Origin</dt>
                        <dd>{profile.origin}</dd>
                    </div>
                    <div>
                        <dt>MBTI</dt>
                        <dd>{profile.mbti}</dd>
                    </div>
                </dl>
                <p class="introduction">{profile.introduction}</p><a
                    class="favorite-jump"
                    href="#favorites">好きなものを見てみる <span>↓</span></a
                >
            </div>
        </section>
        <div class="experience-grid">
            <section aria-labelledby="qualification-title">
                <p class="section-label">01 / MILESTONES</p><h2
                    id="qualification-title"
                    class="section-title"
                >
                    Qualifications
                </h2>
                <ol class="timeline">
                    {
                        [...timeline].reverse().map((item) => (
                            <li>
                                <h3>{item.name}</h3>
                                {item.note && <p>{item.note}</p>}
                            </li>
                        ))
                    }
                </ol>
            </section>
            <section aria-labelledby="skills-title">
                <p class="section-label">02 / TOOLBOX OF IT</p><h2
                    id="skills-title"
                    class="section-title"
                >
                    Skills
                </h2>
                <ul class="skills-grid">
                    {
                        skills.map((skill) => (
                            <li>
                                <>
                                    <span class="skill-icon">
                                        <img
                                            src={skill.icon}
                                            alt=""
                                            width="44"
                                            height="44"
                                            loading="lazy"
                                        />
                                    </span>
                                    <span>{skill.name}</span>
                                </>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>
        <section
            id="favorites"
            class="favorites"
            aria-labelledby="favorites-title"
        >
            <div class="section-heading">
                <div>
                    <p class="section-label">03 / THINGS I LOVE</p><h2
                        id="favorites-title"
                        class="section-title"
                    >
                        Favorites
                    </h2>
                </div>
            </div>
            <div class="gallery-frame">
                <div class="carousel-controls">
                    <button
                        type="button"
                        id="favorite-prev"
                        aria-label="前のお気に入りを表示"
                        aria-controls="favorite-track"
                    >
                        ←
                    </button>
                    <button
                        type="button"
                        id="favorite-next"
                        aria-label="次のお気に入りを表示"
                        aria-controls="favorite-track"
                    >
                        →
                    </button>
                </div>
                <div
                    class="favorite-track"
                    id="favorite-track"
                    tabindex="0"
                    role="region"
                    aria-label="お気に入りの写真。左右にスクロールできます"
                >
                    {
                        favorites.map((item, index) => (
                            <button
                                class="favorite-card"
                                type="button"
                                data-favorite={index}
                                aria-haspopup="dialog"
                                aria-controls="favorite-dialog"
                                aria-label={`${item.title}の写真と説明を開く`}
                            >
                                <>
                                    <img
                                        src={item.image}
                                        alt={item.alt}
                                        width="600"
                                        height="750"
                                        loading="lazy"
                                    />
                                    <span class="card-shade" />
                                    <span class="card-copy">
                                        <>
                                            <small>{item.category}</small>
                                            <strong>{item.title}</strong>
                                        </>
                                    </span>
                                    <span class="card-open" aria-hidden="true">
                                        ↗
                                    </span>
                                </>
                            </button>
                        ))
                    }
                </div><div class="gallery-footer">
                    <span>SWIPE TO EXPLORE</span><span
                        >{String(favorites.length).padStart(2, "0")} FAVORITES</span
                    >
                </div>
            </div>
        </section>
    </div>
    <dialog
        id="favorite-dialog"
        aria-labelledby="favorite-dialog-title"
        aria-describedby="favorite-dialog-description"
    >
        <button type="button" class="dialog-close" aria-label="閉じる" autofocus
            >×</button
        >
        <div class="dialog-layout">
            <div class="dialog-image-wrap">
                <img id="favorite-dialog-image" alt="" />
            </div><div class="dialog-copy">
                <p class="section-label" id="favorite-dialog-category"></p><h2
                    id="favorite-dialog-title"
                >
                </h2><p id="favorite-dialog-description"></p><span
                    class="dialog-note">A PIECE OF MY WORLD</span
                >
            </div>
        </div>
        <!-- .dialog-layout の閉じタグ -->

        <p class="dialog-hint">
            <span class="hint-desktop">
                ウィンドウの外側をクリックすると戻れます
            </span>
            <span class="hint-mobile">
                ウィンドウの外側をタップすると戻れます
            </span>
        </p>
    </dialog>
    <script
        type="application/json"
        id="favorite-data"
        set:html={JSON.stringify(favorites).replace(/</g, "\\u003c")}
    />
</BaseLayout>

<script>
    let cleanup: (() => void) | undefined;
    function setupFavorites() {
        cleanup?.();
        cleanup = undefined;

        const track = document.querySelector<HTMLElement>("#favorite-track");
        const prev =
            document.querySelector<HTMLButtonElement>("#favorite-prev");
        const next =
            document.querySelector<HTMLButtonElement>("#favorite-next");
        const dialog =
            document.querySelector<HTMLDialogElement>("#favorite-dialog");
        const data: {
            title: string;
            category: string;
            image: string;
            alt: string;
            description: string;
        }[] = JSON.parse(
            document.querySelector("#favorite-data")?.textContent || "[]",
        );
        if (track && prev && next && dialog) {
            const sync = () => {
                prev.disabled = track.scrollLeft <= 2;
                next.disabled =
                    track.scrollLeft + track.clientWidth >=
                    track.scrollWidth - 2;
            };
            const scroll = (direction: number) => {
                const card = track.querySelector<HTMLElement>(".favorite-card");
                track.scrollBy({
                    left: direction * ((card?.offsetWidth || 260) + 16),
                    behavior: window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches
                        ? "instant"
                        : "smooth",
                });
            };
            prev.addEventListener("click", () => scroll(-1));
            next.addEventListener("click", () => scroll(1));
            track.addEventListener("scroll", sync, { passive: true });
            const observer = new ResizeObserver(sync);
            observer.observe(track);
            cleanup = () => {
                observer.disconnect();
                if (dialog.open) {
                    dialog.close();
                    document.body.style.overflow = previousOverflow;
                }
            };
            sync();
            track.addEventListener("keydown", (event) => {
                if (
                    event.target === track &&
                    ["ArrowLeft", "ArrowRight"].includes(event.key)
                ) {
                    event.preventDefault();
                    scroll(event.key === "ArrowLeft" ? -1 : 1);
                }
            });
            let trigger: HTMLButtonElement | null = null;
            let previousOverflow = "";
            track
                .querySelectorAll<HTMLButtonElement>("[data-favorite]")
                .forEach((button) =>
                    button.addEventListener("click", () => {
                        const item = data[Number(button.dataset.favorite)];
                        if (!item) return;
                        trigger = button;
                        const image = dialog.querySelector<HTMLImageElement>(
                            "#favorite-dialog-image",
                        )!;
                        image.src = item.image;
                        image.alt = item.alt;
                        dialog.querySelector(
                            "#favorite-dialog-title",
                        )!.textContent = item.title;
                        dialog.querySelector(
                            "#favorite-dialog-category",
                        )!.textContent = item.category;
                        dialog.querySelector(
                            "#favorite-dialog-description",
                        )!.textContent = item.description;
                        previousOverflow = document.body.style.overflow;
                        document.body.style.overflow = "hidden";
                        dialog.showModal();
                    }),
                );
            dialog
                .querySelector(".dialog-close")
                ?.addEventListener("click", () => dialog.close());
            dialog.addEventListener("click", (event) => {
                if (event.target === dialog) {
                    const r = dialog.getBoundingClientRect();
                    if (
                        event.clientX < r.left ||
                        event.clientX > r.right ||
                        event.clientY < r.top ||
                        event.clientY > r.bottom
                    )
                        dialog.close();
                }
            });
            dialog.addEventListener("close", () => {
                document.body.style.overflow = previousOverflow;
                trigger?.focus({ preventScroll: true });
            });
        }
    }
    document.addEventListener("astro:page-load", setupFavorites);
    document.addEventListener("astro:before-swap", () => {
        cleanup?.();
        cleanup = undefined;
    });
</script>
<style>
    .sora-profile {
        --accent: #4c86c5;
    }
    .profile-intro {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        align-items: center;
    }
    .portrait {
        margin: 0;
        position: relative;
    }
    .portrait img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }
    .portrait figcaption {
        position: absolute;
        bottom: 20px;
        left: 24px;
        color: rgb(64, 147, 242);
        font-size: 9px;
        letter-spacing: 0.25em;
        text-shadow: 0 1px 8px #000;
    }
    .section-label {
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 0.2em;
        margin: 0 0 14px;
    }
    .bio h2 {
        font-family: Georgia, serif;
        font-size: clamp(64px, 8vw, 100px);
        line-height: 1.05;
        margin: 0 0 30px;
        letter-spacing: -0.05em;
    }
    .bio h2 span {
        color: var(--accent);
    }
    .personal-details {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        margin: 0 0 30px;
    }
    .personal-details dt {
        font-size: 10px;
        color: var(--muted);
        margin-bottom: 6px;
    }
    .personal-details dd {
        font-size: 14px;
        margin: 0;
    }
    .introduction {
        white-space: pre-line;
        font-size: 13px;
        line-height: 2.2;
    }
    .favorite-jump {
        display: inline-flex;
        align-items: center;
        gap: 28px;
        margin-top: 20px;
        font-size: 11px;
        text-decoration: none;
        padding-bottom: 7px;
        border-bottom: 1px solid var(--border);
    }
    .favorite-jump span {
        font-size: 18px;
    }
    .experience-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        border-top: 1px solid var(--border);
        margin-top: 76px;
        padding-top: 45px;
    }
    .section-title {
        font-family: "Noto Sans JP", sans-serif;
        font-size: 32px;
        line-height: 1;
        font-weight: 500;
        margin: 0 0 30px;
        letter-spacing: -0.02em;
    }
    .section-title span {
        display: block;
        font-size: 11px;
        color: var(--muted);
        margin-top: 10px;
        letter-spacing: 0.05em;
    }
    .timeline {
        list-style: none;
        padding: 0 0 0 22px;
        margin: 0 0 0 5px;
        border-left: 1px solid var(--border);
    }
    .timeline li {
        position: relative;
        margin: 0;
        padding: 0 0 18px;
    }
    .timeline li:last-child {
        padding-bottom: 0;
    }
    .timeline li::before {
        content: "";
        position: absolute;
        left: -27px;
        top: 9px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        border: 1px solid var(--page-bg);
    }
    .timeline time {
        font-size: 11px;
        color: var(--muted);
        letter-spacing: 0.08em;
    }
    .timeline h3 {
        font-size: 16px;
        font-weight: 600;
        margin: -2px 0;
    }
    .timeline p {
        font-size: 11px;
        margin: 0;
    }
    .skills-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

    .skills-grid li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 10px 4px;
        min-width: 0;
        border: 1px solid var(--border);
        font-size: 11px;
        text-align: center;
        overflow-wrap: anywhere;
    }

    .skill-icon {
        display: grid;
        place-items: center;
        background: #f5f5f3;
        border-radius: 12px;
        width: 60px;
        max-width: 100%;
        aspect-ratio: 1;
    }

    .skill-icon img {
        width: 48px;
        max-width: 85%;
        height: auto;
        aspect-ratio: 1;
        object-fit: contain;
    }
    .favorites {
        margin-top: 76px;
        scroll-margin-top: 90px;
    }
    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }
    .carousel-controls {
        display: flex;
        gap: 8px;
    }
    .carousel-controls button {
        border: 1px solid var(--border);
        color: var(--text);
        background: var(--page-bg);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
    }
    .carousel-controls button:disabled {
        opacity: 0.3;
        cursor: default;
    }
    .gallery-frame {
        border: 1px solid var(--border);
        padding: 18px 18px 12px;
        background: var(--surface);
    }
    .favorite-track {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        overscroll-behavior-x: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
        padding-bottom: 12px;
    }
    .favorite-card {
        position: relative;
        flex: 0 0 30%;
        min-width: 230px;
        aspect-ratio: 4/5;
        padding: 0;
        border: 0;
        background: #19242a;
        color: white;
        text-align: left;
        cursor: pointer;
        overflow: hidden;
        scroll-snap-align: start;
    }
    .favorite-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s;
    }
    .favorite-card:hover img {
        transform: scale(1.04);
    }
    .card-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(transparent 35%, #000b);
    }
    .card-copy {
        position: absolute;
        bottom: 24px;
        left: 20px;
        right: 36px;
    }
    .card-copy small {
        display: block;
        font-size: 9px;
        letter-spacing: 0.18em;
        margin-bottom: 8px;
    }
    .card-copy strong {
        font-size: 17px;
        font-weight: 400;
    }
    .card-open {
        position: absolute;
        bottom: 25px;
        right: 18px;
        font-size: 20px;
    }
    .gallery-footer {
        display: flex;
        justify-content: space-between;
        font-size: 8px;
        letter-spacing: 0.16em;
        color: var(--muted);
        padding-top: 8px;
    }
    .social-section {
        margin-top: 76px;
        padding: 40px 0;
        text-align: center;
    }
    .social-section h2 {
        font-family: Georgia, serif;
        font-size: 42px;
        margin: 0 0 26px;
    }
    .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
    }
    .social-links a,
    .social-links button {
        display: inline-flex;
        gap: 36px;
        align-items: center;
        padding: 12px 22px;
        border: 1px solid var(--border);
        color: var(--text);
        background: transparent;
        text-decoration: none;
        font-size: 12px;
    }
    .social-links a:hover {
        background: var(--surface-hover);
    }
    .social-links button:disabled {
        color: var(--muted);
        cursor: default;
    }
    .unconfigured {
        font-size: 10px;
    }
    dialog {
        padding: 0;
        border: 1px solid var(--border);
        width: min(960px, calc(100vw - 40px));
        max-height: 85svh;
        background: var(--page-bg);
        color: var(--text);
        overflow: auto;
    }
    dialog::backdrop {
        background: #000b;
        backdrop-filter: blur(8px);
    }
    .dialog-layout {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        min-height: 420px;
    }
    .dialog-image-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--surface);
    }
    .dialog-image-wrap img {
        display: block;
        width: 100%;
        max-height: 75svh;
        object-fit: contain;
    }
    .dialog-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 60px 36px;
    }
    .dialog-copy h2 {
        font-family: Georgia, "Noto Sans JP", serif;
        font-size: 30px;
        margin: 0 0 22px;
    }
    #favorite-dialog-description {
        font-size: 13px;
        line-height: 2.1;
        white-space: pre-line;
    }
    .dialog-note {
        margin-top: 35px;
        color: var(--muted);
        font-size: 8px;
        letter-spacing: 0.2em;
    }
    .dialog-close {
        position: absolute;
        z-index: 1;
        top: 15px;
        right: 15px;
        width: 44px;
        height: 44px;
        border: 1px solid var(--border);
        border-radius: 50%;
        background: var(--page-bg);
        color: var(--text);
        font-size: 22px;
        cursor: pointer;
    }
    @media (max-width: 700px) {
        .profile-intro,
        .experience-grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }
        .portrait img {
            aspect-ratio: 1 / 1;
        }
        .bio h2 {
            font-size: 72px;
        }
        .experience-grid,
        .favorites,
        .social-section {
            margin-top: 50px;
        }
        .experience-grid {
            gap: 40px;
            padding-top: 32px;
        }
        .section-title {
            font-size: 29px;
        }
        .favorite-card {
            flex-basis: 78%;
            min-width: 0;
        }
        .gallery-frame {
            padding: 12px 12px 10px;
        }
        .dialog-layout {
            grid-template-columns: 1fr;
            min-height: 0;
        }
        .dialog-image-wrap img {
            max-height: 42svh;
        }
        .dialog-copy {
            padding: 28px 24px;
        }
        .dialog-copy h2 {
            font-size: 26px;
        }
        .dialog-note {
            margin-top: 18px;
        }
    }

    .gallery-frame {
        position: relative;
    }

    .carousel-controls {
        position: absolute;
        top: 50%;
        left: -30;
        right: -30;
        transform: translateY(-50%);
        z-index: 2;

        display: flex;
        justify-content: space-between;
        padding: 0 6px;
        pointer-events: none;
    }

    .carousel-controls button {
        pointer-events: auto;
        flex-shrink: 0;
        width: 40px;
        height: 40px;

        background: var(--page-bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 50%;
        box-shadow: 0 2px 12px #0003;
    }

    .carousel-controls button:hover:not(:disabled) {
        background: var(--surface-hover);
    }
    .social-links {
        gap: 20px;
    }

    .social-links .social-icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        padding: 10px;
        border: none;
        border-radius: 50%;
        color: var(--text);
        background: transparent;
        text-decoration: none;
    }

    .social-icon-link svg {
        width: 28px;
        height: 28px;
    }

    .social-links .social-icon-link:hover {
        background: var(--surface-hover);
    }

    .social-links .social-icon-link[aria-disabled="true"] {
        opacity: 0.35;
        pointer-events: none;
    }

    .dialog-hint {
        position: fixed;
        bottom: 55px;
        left: 0;
        width: 100%;
        margin: 0;
        padding: 0 16px;

        text-align: center;
        font-size: 11px;
        line-height: 1.6;
        color: #fff;
        text-shadow: 0 1px 6px #000;

        pointer-events: none;
    }
    /* PCでは従来の文章だけを表示 */
    .hint-mobile {
        display: none;
    }

    @media (max-width: 700px) {
        /* 外枠はスクロールさせない */
        #favorite-dialog {
            overflow: visible;
            max-height: none;
        }

        /* 画像と説明の部分だけをスクロール */
        #favorite-dialog .dialog-layout {
            max-height: min(70dvh, calc(100dvh - 120px));
            overflow-y: auto;
            overscroll-behavior: contain;
        }

        /* ×は外枠に固定するため、本文をスクロールしても残る */
        #favorite-dialog .dialog-close {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 3;
        }

        /* 案内文はウィンドウの下端から18px下 */
        #favorite-dialog .dialog-hint {
            position: absolute;
            top: calc(100% + 18px);
            bottom: auto;
            left: 0;
            width: 100%;
            margin: 0;
            padding: 0 4px;
            font-size: 10px;
            line-height: 1.6;
            pointer-events: none;
        }

        .hint-desktop {
            display: none;
        }

        .hint-mobile {
            display: inline;
        }
    }
    .social-links .site-share-button {
        background: transparent;
        color: var(--text);
        cursor: pointer;
    }

    .site-share-button:disabled {
        opacity: 0.5;
        cursor: wait;
    }

    .site-share-status {
        margin: 8px 0 0;
        text-align: center;
        font-size: 11px;
        color: var(--muted);
    }

    .site-share-status:empty {
        display: none;
    }
    .favorite-jump:hover {
        /* 文字の幅・高さを変えずに太く見せる */
        text-shadow:
            0.3px 0 currentColor,
            -0.3px 0 currentColor;

