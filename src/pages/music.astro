---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlayerIcon from "../components/PlayerIcon.astro";
import { tracks } from "../data/music";

// tracksは追加日の古い順。ジャンルごとに01から番号を付ける。
const genres = [
    ...new Set(["洋楽", "Instrumental", ...tracks.map((track) => track.genre)]),
];
const genreCounts: Record<string, number> = Object.fromEntries(
    genres.map((genre) => [genre, 0]),
);
const trackNumbers = new Map<string, number>();

for (const track of tracks) {
    genreCounts[track.genre]++;
    trackNumbers.set(track.id, genreCounts[track.genre]);
}
---

<BaseLayout pageTitle="Music" music>
    <section class="music-library" aria-label="自作曲のライブラリ">
        <div class="music-intro"></div>
        <div class="music-toolbar">
            <div class="music-filters" role="group" aria-label="曲のジャンル">
                {
                    genres.map((genre) => (
                        <button
                            type="button"
                            data-music-filter={genre}
                            aria-pressed={genre === "洋楽"}
                        >
                            {genre}
                        </button>
                    ))
                }
                <button
                    type="button"
                    class="music-shuffle"
                    data-music-sequence
                    aria-label="表示中の曲を表示順に連続再生"
                    title="順番再生"
                >
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M3 7h18m-4-4 4 4-4 4M3 17h18m-4-4 4 4-4 4"
                        ></path>
                    </svg>
                </button>
                <button
                    type="button"
                    class="music-shuffle"
                    data-music-shuffle
                    aria-label="ランダム再生"
                    title="ランダム再生"
                >
                    <PlayerIcon name="shuffle" />
                </button>
            </div>
            <div class="music-view-actions">
                <button
                    type="button"
                    class="music-view-toggle"
                    data-music-view-toggle
                    aria-label="ジャケットを縮小表示"
                    aria-pressed="false"
                    title="ジャケットを縮小表示"
                >
                    <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <circle cx="10" cy="10" r="6.5"></circle>
                        <path d="m15 15 5.5 5.5M7 10h6"></path>
                        <path class="zoom-plus" d="M10 7v6"></path>
                    </svg>
                </button>

                <button
                    type="button"
                    class="music-sort"
                    data-music-sort
                    aria-label="現在は新しい順。古い順に切り替える"
                >
                    新着順↓
                </button>
            </div>
        </div>
        <ul class="music-grid">
            {
                tracks.map((track, index) => (
                    <li
                        class="music-card"
                        data-track-card={track.id}
                        data-track-genre={track.genre}
                        data-track-index={index}
                        hidden={track.genre !== "洋楽"}
                    >
                        <button
                            type="button"
                            class="record-button"
                            data-track-play={track.id}
                            aria-label={`${track.title}を再生`}
                            aria-pressed="false"
                        >
                            <span class="record-image">
                                <img
                                    src={track.cover}
                                    alt={`${track.title}のジャケット`}
                                    width="600"
                                    height="600"
                                    loading={index < 4 ? "eager" : "lazy"}
                                />
                            </span>
                            <span class="record-action">
                                <>
                                    <PlayerIcon
                                        name="play"
                                        class="record-play"
                                    />
                                    <PlayerIcon
                                        name="pause"
                                        class="record-pause"
                                    />
                                </>
                            </span>
                        </button>
                        <div class="music-card-copy">
                            <>
                                <div>
                                    <>
                                        <h2>{track.title}</h2>
                                        <p>
                                            {track.artist} <span>·</span>{" "}
                                            {track.genre}
                                        </p>
                                    </>
                                </div>
                                <span class="record-number">
                                    {String(
                                        trackNumbers.get(track.id),
                                    ).padStart(2, "0")}
                                </span>
                            </>
                        </div>
                    </li>
                ))
            }
        </ul>
        <p id="music-empty" hidden>このジャンルの曲は、まだありません。</p>
        <div class="music-collection-meta">
            <span>Created by Sora</span><span
                id="music-count"
                aria-live="polite"
            >
                {genreCounts["洋楽"]} TRACK{
                    genreCounts["洋楽"] === 1 ? "" : "S"
                }
            </span>
        </div>
    </section>
</BaseLayout>
<script>
    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const button = event.target.closest<HTMLButtonElement>(
            "[data-music-view-toggle]",
        );
        if (!button) return;

        const library = button.closest<HTMLElement>(".music-library");
        const grid = library?.querySelector<HTMLElement>(".music-grid");
        if (!grid) return;

        const cards = Array.from(
            grid.querySelectorAll<HTMLElement>(".music-card:not([hidden])"),
        );

        // 連続クリック時は、前回のアニメーションを終了する。
        cards.forEach((card) => {
            card.getAnimations().forEach((animation) => animation.cancel());
        });

        const before = cards.map((card) => card.getBoundingClientRect());

        const compact = grid.classList.toggle("is-compact");

        button.setAttribute("aria-pressed", String(compact));

        const label = compact
            ? "ジャケットを標準サイズに戻す"
            : "ジャケットを縮小表示";

        button.setAttribute("aria-label", label);
        button.title = label;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return;
        }

        const after = cards.map((card) => card.getBoundingClientRect());

        cards.forEach((card, index) => {
            const from = before[index];
            const to = after[index];
            if (!to.width || !to.height) return;

            card.animate(
                [
                    {
                        transformOrigin: "top left",
                        transform: `
                            translate(${from.left - to.left}px, ${from.top - to.top}px)
                            scale(${from.width / to.width}, ${from.height / to.height})
                        `,
                    },
                    {
                        transformOrigin: "top left",
                        transform: "translate(0, 0) scale(1)",
                    },
                ],
                {
                    duration: 380,
                    easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                },
            );
        });
    });
</script>
