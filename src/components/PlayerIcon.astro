---
const { name, class: className = "" } = Astro.props;
---

<svg
    class={className}
    viewBox="0 0 24 24"
    width="24"
    height="24"
    aria-hidden="true"
    focusable="false"
>
    {name === "play" && <path fill="currentColor" d="M8 4.5v15l12-7.5z" />}
    {
        name === "pause" && (
            <path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z" />
        )
    }
    {
        name === "close" && (
            <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                d="m6 6 12 12M18 6 6 18"
            />
        )
    }
    {
        name === "previous" && (
            <path fill="currentColor" d="M5 5h3v14H5zm14 0v14L9 12z" />
        )
    }
    {
        name === "next" && (
            <path fill="currentColor" d="M16 5h3v14h-3zM5 5l10 7-10 7z" />
        )
    }
    {
        name === "shuffle" && (
            <g
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M3 6h2c4 0 10 12 14 12h2m-4-4 4 4-4 4" />
                <path d="M3 18h2c1.5 0 3.2-1.7 5-4M14 9c1.8-2 3.5-3 5-3h2m-4-4 4 4-4 4" />
            </g>
        )
    }
</svg>
