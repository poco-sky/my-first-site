---
import { socials } from "../data/profile";
---

<section class="shared-socials" aria-label="SNS・サイトの共有">
    <div class="social-links">
        {
            socials.map((social) => (
                <a
                    href={social.url || undefined}
                    class="social-icon-link"
                    aria-label={social.name}
                    aria-disabled={!social.url ? "true" : undefined}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {social.name === "Instagram" && (
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            aria-hidden="true"
                        >
                            <rect x="3" y="3" width="18" height="18" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle
                                cx="17.5"
                                cy="6.5"
                                r="1"
                                fill="currentColor"
                                stroke="none"
                            />
                        </svg>
                    )}

                    {social.name === "GitHub" && (
                        <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.699.078-.685.078-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.722 2.637 1.225 3.28.937.102-.728.393-1.225.715-1.507-2.499-.284-5.126-1.25-5.126-5.566 0-1.23.44-2.233 1.16-3.02-.117-.285-.503-1.43.11-2.98 0 0 .945-.302 3.094 1.154a10.79 10.79 0 0 1 5.625 0c2.148-1.456 3.091-1.154 3.091-1.154.615 1.55.229 2.695.112 2.98.722.787 1.158 1.79 1.158 3.02 0 4.327-2.631 5.279-5.138 5.558.404.35.766 1.043.766 2.1 0 1.517-.014 2.741-.014 3.113 0 .3.203.65.774.54A11.25 11.25 0 0 0 12 .75Z" />
                        </svg>
                    )}
                    {social.name === "Suno" && (
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M9 18V5l12-2v13" />
                            <path d="M9 9l12-2" />
                            <ellipse cx="6" cy="18" rx="3" ry="3" />
                            <ellipse cx="18" cy="16" rx="3" ry="3" />
                        </svg>
                    )}
                </a>
            ))
        }
        <button
            type="button"
            class="social-icon-link site-share-button"
            data-site-share
            aria-label="このサイトを共有"
            title="このサイトを共有"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M12 15V3m-4 4 4-4 4 4"></path>
                <path d="M5 11v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"></path>
            </svg>
        </button>
    </div>
    <p class="site-share-status" data-share-status role="status"></p>
</section>
<script>
    document.addEventListener("click", async (event) => {
        if (!(event.target instanceof Element)) return;

        const button =
            event.target.closest<HTMLButtonElement>("[data-site-share]");

        if (!button || button.disabled) return;

        const status = document.querySelector<HTMLElement>(
            "[data-share-status]",
        );

        // 今開いているサイトのホームURLを共有。
        const url = new URL("/", window.location.href).href;

        const shareData = {
            title: "IN THE SKY",
            url,
        };

        if (status) status.textContent = "";
        button.disabled = true;

        try {
            if (typeof navigator.share === "function") {
                try {
                    await navigator.share(shareData);
                    return;
                } catch (error) {
                    // 共有画面をキャンセルした場合は何もしない。
                    if (
                        error instanceof DOMException &&
                        error.name === "AbortError"
                    ) {
                        return;
                    }
                }
            }

            // 共有画面を使えない場合はURLをコピー。
            try {
                await navigator.clipboard.writeText(url);

                if (status) {
                    status.textContent = "サイトのURLをコピーしました。";
                }
            } catch {
                // コピーが許可されない場合は手動コピー用に表示。
                window.prompt("このURLをコピーして共有してください。", url);
            }
        } finally {
            button.disabled = false;
        }
    });
</script>
<style>
    .shared-socials {
        padding: 65px 0 12px;
    }

    .social-links {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .social-links .social-icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        padding: 10px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: var(--text);
        text-decoration: none;
        cursor: pointer;
    }

    .social-icon-link svg {
        width: 28px;
        height: 28px;
    }

    .social-icon-link img {
        width: 28px;
        height: 28px;
        object-fit: contain;
    }

    .social-links .social-icon-link:hover {
        background: var(--surface-hover);
    }

    .social-icon-link[aria-disabled="true"] {
        opacity: 0.35;
        pointer-events: none;
    }

    .site-share-button:disabled {
        opacity: 0.5;
        cursor: wait;
    }

    .site-share-status {
        margin: 8px 0 0;
        text-align: center;
        font-size: 11px;
        color: var(--muted);
    }

    .site-share-status:empty {
        display: none;
    }
</style>
