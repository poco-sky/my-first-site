<button
  type="button"
  class="theme-toggle"
  aria-label="ブラックテーマ"
  aria-pressed="false"
  title="白・黒のテーマを切り替える"
>
  <svg
    class="theme-moon"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
    ><path d="M20.8 13.1A9 9 0 0 1 10.9 3.2 9 9 0 1 0 20.8 13.1Z"></path></svg
  >
  <svg
    class="theme-sun"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
    ></path></svg
  >
  <span class="theme-label">THEME</span>
</button>
<script>
  let darkTheme = document.documentElement.dataset.theme === "dark";
  const applyTheme = () => {
    document.documentElement.dataset.theme = darkTheme ? "dark" : "light";
    const toggle = document.querySelector(".theme-toggle");
    toggle?.setAttribute("aria-pressed", String(darkTheme));
    toggle?.setAttribute(
      "aria-label",
      darkTheme ? "ホワイトテーマに切り替える" : "ブラックテーマに切り替える",
    );
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", darkTheme ? "#101112" : "#ffffff");
  };
  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest(".theme-toggle")) return;
    darkTheme = !darkTheme;
    applyTheme();
    try {
      localStorage.setItem("my-site-theme", darkTheme ? "dark" : "light");
    } catch {}
  });
  document.addEventListener("astro:after-swap", applyTheme);
  document.addEventListener("astro:page-load", applyTheme);
  window.addEventListener("storage", (event) => {
    if (event.key === "my-site-theme" || event.key === null) {
      darkTheme = event.newValue === "dark";
      applyTheme();
    }
  });
  applyTheme();
</script>
