---
import { getCollection } from "astro:content";
import { notifications, type Notice } from "../data/notifications";
import "../styles/notifications.css";

const [music, blog, fashion] = await Promise.all([
    getCollection("music"),
    getCollection("blog"),
    getCollection("fashion"),
]);
const notices: Notice[] = [
    ...notifications,
    ...fashion.flatMap((entry) => {
        if (!entry.data.addedAt) return [];

        return [
            {
                text: "FASHIONページに新たな",
                emphasis: entry.data.category,
                suffix: "を追加しました．",
                href: `/fashion/${entry.id}/`,
                date: entry.data.addedAt.toISOString().slice(0, 10),
                kind: "fashion" as const,
            },
        ];
    }),
    ...music.map((entry) => ({
        text: "MUSICに",
        emphasis: `"${entry.data.title} (${entry.data.genre})"`,
        href: `/music/?genre=${encodeURIComponent(entry.data.genre)}`,
        date: entry.data.addedAt.toISOString().slice(0, 10),
        kind: "music" as const,
    })),
    ...blog.map((entry) => ({
        text: "BLOGに",
        emphasis: `「${entry.data.title}」`,
        href: `/posts/${entry.id}/`,
        date: entry.data.pubDate.toISOString().slice(0, 10),
        kind: "blog" as const,
    })),
].sort((a, b) => b.date.localeCompare(a.date));
const formatDate = (date: string) => {
    const [year, month, day] = date.split("-");
    return `${year}/${month}/${day}`;
};
---

<site-notifications>
    <button
        type="button"
        class="notice-toggle"
        aria-label="お知らせ"
        title="お知らせを開く"
        aria-expanded="false"
        aria-controls="notice-panel"
    >
        <svg
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"
            ></path>
        </svg>
    </button>
    <section
        id="notice-panel"
        class="notice-panel"
        aria-labelledby="notice-heading"
        hidden
    >
        <div class="notice-heading-row">
            <h2 id="notice-heading">お知らせ</h2><span>UPDATES</span>
        </div>
        {
            notices.length ? (
                <ul class="notice-list">
                    {notices.map((notice) => (
                        <li>
                            <a href={notice.href}>
                                <span class="notice-icon" aria-hidden="true">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.4"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        {notice.kind === "music" && (
                                            <>
                                                <path d="M9 18V5l12-2v13M9 9l12-2" />
                                                <ellipse
                                                    cx="6"
                                                    cy="18"
                                                    rx="3"
                                                    ry="3"
                                                />
                                                <ellipse
                                                    cx="18"
                                                    cy="16"
                                                    rx="3"
                                                    ry="3"
                                                />
                                            </>
                                        )}

                                        {notice.kind === "blog" && (
                                            <>
                                                <path d="M12 5v16" />
                                                <path d="M12 5C9 3 5 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-3-1-7-1-10 1Z" />
                                                <path d="M5 8c1.5-.2 3 .1 4 1M15 9c1-.9 2.5-1.2 4-1" />
                                            </>
                                        )}

                                        {notice.kind === "favorite" && (
                                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
                                        )}
                                        {notice.kind === "fashion" && (
                                            <path
                                                d="M8 3 2 6l3 6 3-1v10h8V11l3 1 3-6-6-3c0 2-1.8 3-4 3S8 5 8 3Z"
                                            />
                                        )}
                                    </svg>
                                </span>

                                <span class="notice-copy">
                                    <span class="notice-message">
                                        {notice.text}
                                        {notice.emphasis && (
                                            <>
                                                <strong>
                                                    {notice.emphasis}
                                                </strong>
                                                {notice.suffix ??
                                                    "を追加しました．"}
                                            </>
                                        )}
                                    </span>

                                    <time datetime={notice.date}>
                                        {formatDate(notice.date)}
                                    </time>
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="notice-empty">お知らせはまだありません。</p>
            )
        }
    </section>
</site-notifications>

<script>
    import "../scripts/notifications";
</script>
