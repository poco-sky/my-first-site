---
import ThemeToggle from "./ThemeToggle.astro";
import Navigation from "./Navigation.astro";
import Notifications from "./Notifications.astro";
---

<header class="site-header">
    <ThemeToggle />
    <a class="wordmark" href="/" aria-label="マイサイト ホーム">IN THE SKY</a>
    <Notifications />
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-menu"
        ><span class="menu-label">MENU</span><span
            class="menu-lines"
            aria-hidden="true"></span></button
    >
    <div class="navigation-anchor"><Navigation /></div>
</header>
<script>
    // ページ移動でDOMが入れ替わるため、その都度現在のナビを参照する。
    const closeMenu = () =>
        document
            .querySelector(".menu-toggle")
            ?.setAttribute("aria-expanded", "false");
    document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const target = event.target;
        const button = target.closest(".menu-toggle");

        // ハンバーガーボタンを押したら開閉
        if (button) {
            button.setAttribute(
                "aria-expanded",
                String(button.getAttribute("aria-expanded") !== "true"),
            );
            return;
        }

        // ナビゲーションのリンクを押したら閉じる
        if (target.closest("#main-menu a")) {
            closeMenu();
            return;
        }

        // スマホでは、メニューの外側をタップしても閉じる
        if (
            window.matchMedia("(max-width: 700px)").matches &&
            !target.closest("#main-menu")
        ) {
            closeMenu();
        }
    });
    document.addEventListener("keydown", (event) => {
        const button =
            document.querySelector<HTMLButtonElement>(".menu-toggle");
        if (
            event.key === "Escape" &&
            button?.getAttribute("aria-expanded") === "true"
        ) {
            closeMenu();
            button.focus();
        }
    });
    window
        .matchMedia("(min-width: 701px)")
        .addEventListener("change", closeMenu);
    const updateNavigation = () => {
        const anchor =
            document.querySelector<HTMLElement>(".navigation-anchor");
        const navigation = document.querySelector<HTMLElement>("#main-menu");
        const compactFashionHeader =
            document.body.classList.contains("fashion-detail-page") &&
            window.matchMedia("(min-width: 1101px)").matches;

        const pinned =
            compactFashionHeader ||
            (!!anchor && anchor.getBoundingClientRect().top <= 0);
        if (navigation?.classList.contains("is-pinned") !== pinned) {
            navigation?.classList.toggle("is-pinned", pinned);
            closeMenu();
        }
    };
    let scheduled = false;
    window.addEventListener(
        "scroll",
        () => {
            if (scheduled) return;
            scheduled = true;
            requestAnimationFrame(() => {
                updateNavigation();
                scheduled = false;
            });
        },
        { passive: true },
    );
    window.addEventListener("resize", updateNavigation);
    window.addEventListener("pageshow", updateNavigation);
    document.addEventListener("astro:page-load", updateNavigation);
    updateNavigation();
</script>
